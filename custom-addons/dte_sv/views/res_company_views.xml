<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agrega campos DTE al formulario de empresa (Ajustes → Empresas) -->
    <record id="view_company_form_dte_sv" model="ir.ui.view">
        <field name="name">res.company.form.dte.sv</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Facturación Electrónica DTE" name="dte_sv_config">

                    <!-- Datos del Emisor -->
                    <group string="Datos del Emisor">
                        <group>
                            <field name="dte_nit"              placeholder="Ej: 06141309101051"/>
                            <field name="dte_nrc"              placeholder="Ej: 123456-7"/>
                            <field name="dte_nombre_comercial" placeholder="Deja vacío para usar el nombre legal"/>
                            <field name="dte_tipo_establecimiento" placeholder="Ej: 01"/>
                        </group>
                        <group>
                            <field name="dte_cod_actividad"  placeholder="Ej: 47111"/>
                            <field name="dte_desc_actividad" placeholder="Ej: Venta al por menor en comercios no especializados"/>
                            <field name="dte_departamento"   placeholder="Ej: 06"/>
                            <field name="dte_municipio"      placeholder="Ej: 23"/>
                            <field name="dte_distrito"       placeholder="Ej: 0614"/>
                        </group>
                    </group>

                    <!-- Credenciales -->
                    <group string="Credenciales">
                        <group>
                            <field name="dte_nit"                  placeholder="Ej: 06140101991011"/>
                            <field name="dte_password_mh"          password="True"/>
                            <field name="dte_password_certificado" password="True"/>
                        </group>
                        <group>
                            <field name="dte_token"        readonly="1"/>
                            <field name="dte_token_expiry" readonly="1"/>
                        </group>
                    </group>

                    <!-- URLs -->
                    <group string="URLs de Conexión">
                        <group>
                            <field name="dte_url_auth"      placeholder="https://apitest.dtes.mh.gob.sv/seguridad/auth"/>
                            <field name="dte_url_recepcion" placeholder="https://apitest.dtes.mh.gob.sv/fesv/recepciondte/"/>
                            <field name="dte_url_firmador"  placeholder="http://localhost:8113"/>
                        </group>
                    </group>

                    <!-- Códigos de establecimiento -->
                    <group string="Configuración MH El Salvador">
                        <group>
                            <field name="dte_establecimiento" placeholder="Ej: S048"/>
                            <field name="dte_punto_venta"     placeholder="Ej: P001"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                El Número de Control se generará con el formato:<br/>
                                <strong>DTE-{tipo}-{establecimiento}{punto_venta}-{correlativo}</strong><br/>
                                Ejemplo: DTE-01-S048P001-000000000000001
                            </div>
                        </group>
                    </group>

                </page>
            </notebook>
        </field>
    </record>
</odoo>
