<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_dte_sv"
              inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='payment_term']" position="after">

            <t t-if="o.dte_codigo_generacion or o.dte_numero_control">

                <div style="margin-top:20px; border-top:1.5px solid #1F4E79;"/>

                <div style="background:#1F4E79; color:white; padding:5px 10px;">
                    <strong style="font-size:10px; letter-spacing:0.5px;">
                        DOCUMENTO TRIBUTARIO ELECTRÓNICO (DTE)
                    </strong>
                </div>

                <table width="100%" style="font-size:9px; border-collapse:collapse;">
                    <tr>
                        <td width="50%" style="padding:6px 10px; border:1px solid #DDEBF7; background:#F5F9FF;">
                            <div style="color:#555; margin-bottom:2px;"><strong>Tipo DTE</strong></div>
                            <div>
                                <t t-if="o.tipo_dte == '01'">Factura de Consumidor Final</t>
                                <t t-elif="o.tipo_dte == '03'">Comprobante de Crédito Fiscal</t>
                                <t t-elif="o.tipo_dte == '05'">Nota de Crédito</t>
                                <t t-else=""><t t-esc="o.tipo_dte or 'N/A'"/></t>
                            </div>
                        </td>
                        <td width="50%" style="padding:6px 10px; border:1px solid #DDEBF7; border-left:none; background:#F5F9FF;">
                            <div style="color:#555; margin-bottom:2px;"><strong>Estado DTE</strong></div>
                            <div>
                                <t t-if="o.estado_dte == 'aceptado'">Aceptado</t>
                                <t t-elif="o.estado_dte == 'invalidado'">Invalidado</t>
                                <t t-elif="o.estado_dte == 'rechazado'">Rechazado</t>
                                <t t-elif="o.estado_dte == 'pendiente'">Pendiente de Envío</t>
                                <t t-elif="o.estado_dte == 'enviado'">Enviado</t>
                                <t t-elif="o.estado_dte == 'fuera_de_plazo'">Fuera de Plazo</t>
                                <t t-elif="o.estado_dte == 'error_invalidacion'">Error en Invalidación</t>
                                <t t-else=""><t t-esc="o.estado_dte or 'N/A'"/></t>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding:6px 10px; border:1px solid #DDEBF7; border-top:none; background:white;">
                            <div style="color:#555; margin-bottom:2px;"><strong>Código de Generación</strong></div>
                            <div style="font-family:monospace; font-size:9px; color:#1F4E79; letter-spacing:0.3px;">
                                <t t-esc="o.dte_codigo_generacion or 'No generado'"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding:6px 10px; border:1px solid #DDEBF7; border-top:none; background:white;">
                            <div style="color:#555; margin-bottom:2px;"><strong>Número de Control</strong></div>
                            <div style="font-family:monospace; font-size:9px; color:#1F4E79; letter-spacing:0.3px;">
                                <t t-esc="o.dte_numero_control or 'No asignado'"/>
                            </div>
                        </td>
                    </tr>

                    <!-- Sello de recepción — visible cuando fue aceptado o invalidado -->
                    <t t-if="o.dte_sello_recepcion and o.estado_dte in ('aceptado', 'invalidado')">
                        <tr>
                            <td colspan="2" style="padding:6px 10px; border:1px solid #C6EFCE; border-top:none; background:#F0FFF4;">
                                <div style="color:#276221; margin-bottom:2px;">
                                    <strong>✓ Sello de Recepción MH</strong>
                                </div>
                                <div style="font-family:monospace; font-size:8px; color:#276221; word-break:break-all;">
                                    <t t-esc="o.dte_sello_recepcion"/>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding:6px 10px; border:1px solid #C6EFCE; border-top:none; background:#F0FFF4;">
                                <div style="color:#276221; margin-bottom:2px;">
                                    <strong>Fecha de Procesamiento MH</strong>
                                </div>
                                <div style="color:#276221;">
                                    <t t-esc="o.dte_fecha_procesamiento or 'N/A'"/>
                                </div>
                            </td>
                        </tr>
                    </t>

                    <!-- Aviso de anulación — solo cuando el DTE fue invalidado -->
                    <t t-if="o.estado_dte == 'invalidado'">
                        <tr>
                            <td colspan="2" style="padding:6px 10px; border:1px solid #F5C6CB; border-top:none; background:#FFF5F5;">
                                <div style="color:#721C24; margin-bottom:2px;">
                                    <strong>✗ DTE ANULADO ANTE EL MINISTERIO DE HACIENDA</strong>
                                </div>
                                <div style="font-size:8px; color:#721C24;">
                                    Este documento tributario electrónico fue invalidado y no tiene validez fiscal.
                                </div>
                            </td>
                        </tr>
                    </t>

                </table>

                <div style="font-size:7.5px; color:#888; text-align:center; margin-top:6px; font-style:italic;">
                    Este documento es un DTE emitido conforme a las disposiciones del Ministerio de Hacienda de El Salvador.
                </div>

            </t>

        </xpath>

    </template>

</odoo>
