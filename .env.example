# ============================================================================
# CONFIGURACIÓN DEL SISTEMA DE FACTURACIÓN ELECTRÓNICA
# ============================================================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo a `.env` en la raíz del proyecto
# 2. Reemplazar los valores de ejemplo con valores reales
# 3. NUNCA subir `.env` a Git (está en .gitignore)
# 4. En producción, usar variables de entorno del servidor
#
# ============================================================================
# BASE DE DATOS - PostgreSQL
# ============================================================================

# Nombre de la base de datos
POSTGRES_DB=farmacia_db

# Usuario de PostgreSQL
POSTGRES_USER=odoo_user

# Contraseña de PostgreSQL (cambiar en producción)
# Usar contraseña FUERTE: mínimo 12 caracteres, incluir mayúsculas, números, símbolos
POSTGRES_PASSWORD=TuPasswordSeguroAqui123!@#

# ============================================================================
# ODOO - Configuración
# ============================================================================

# Master password (contraseña administrativa de Odoo)
# Esta contraseña protege funciones administrativas críticas
# Cambiar OBLIGATORIAMENTE en producción
ODOO_ADMIN_PASSWD=TuAdminPasswordAqui123!@#

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# SEGURIDAD EN PRODUCCIÓN:
# - Cambiar TODAS las contraseñas
# - Usar variables de entorno del servidor (no .env en disco)
# - Habilitar SSL/TLS (Nginx proxy)
# - Configurar cortafuegos
# - Restringir acceso a puerto 8069
# - Realizar backups automáticos
#
# Ver: docs/despliegue.md#11-seguridad-en-producción
#
# ============================================================================
